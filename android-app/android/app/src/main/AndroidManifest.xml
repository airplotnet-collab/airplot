<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Required for BatteryOptimization.requestIgnoreBatteryOptimization() to show Android's
         own "Allow" exemption dialog directly, so background tracking/uploads aren't killed by
         the OS. Must be declared before <application>, per the plugin's own install docs. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Overdue reminder / overdue alarms (TrackerNotificationPlugin) - posts the alert even
             while the app's page is asleep in the background. -->
        <receiver android:name=".OverdueAlarmReceiver" android:exported="false" />

        <!-- Notification centre (admins / event managers): watches the server for Mayday,
             Pan-Pan, overdue and trip start/end and pops up a notification, screen off too.
             specialUse: no other foreground-service type fits a "watch for alerts" service. -->
        <service
            android:name=".NotifyCentreService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Safety monitoring: alerts admins and event managers when a tracked trip declares Mayday or Pan-Pan, becomes overdue, or starts or ends." />
        </service>
        <!-- Shortcut buttons on those notifications (snooze / turn off). -->
        <receiver android:name=".NotifyActionReceiver" android:exported="false" />
        <!-- Turns the notification centre back on after a restart or app update. -->
        <receiver android:name=".NotifyBootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Required for the background-geolocation plugin to keep recording position with the
         screen off or the app not in the foreground. ACCESS_BACKGROUND_LOCATION is subject to
         Google Play's manual review for background-location apps if this is ever published
         there (not required for a sideloaded/direct-install APK). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Android 13+ requires this to show the "Tracking active" notification the foreground
         service depends on to keep running. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Overdue alarm on time to the second. Without it (Android 14+ doesn't grant it by
         default) the alarm still fires, but Android may delay it a few minutes while idle. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Notification centre: its own foreground-service type, keeping the CPU awake between
         checks and lighting the screen for an alert, and restarting after the phone restarts. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
</manifest>
