<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/notif_title_big"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#2E7D32"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notif_speed_big"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#388E3C"
            android:textSize="13sp"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/notif_text_big"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#388E3C"
            android:textSize="13sp"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/notif_overdue_big"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#388E3C"
            android:textSize="13sp"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/notif_mode_big"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#388E3C"
            android:textSize="13sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <Button
            android:id="@+id/notif_action_btn_big"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:textColor="#FFFFFFFF"
            android:textStyle="bold"
            android:textSize="14sp"
            android:background="@drawable/notif_btn_record" />

        <!-- Close app - hidden while recording (TrackerNotificationPlugin.render) -->
        <Button
            android:id="@+id/notif_close_btn_big"
            android:layout_width="72dp"
            android:layout_height="30dp"
            android:layout_marginTop="8dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="CLOSE"
            android:textColor="#FFFFFFFF"
            android:textStyle="bold"
            android:textSize="11sp"
            android:background="@drawable/notif_btn_close" />
    </LinearLayout>
</LinearLayout>
